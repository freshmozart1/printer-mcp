{
  "name": "printer-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing printing, scanning and copying on an HP OfficeJet Pro 9015e",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "printer-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "node src/index.ts",
    "start:http": "node src/index.ts --http",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:ocr": "swiftc -O -parse-as-library native/ocr.swift -o native/ocr",
    "postinstall": "npm run build:ocr",
    "cert": "./scripts/generate-cert.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "markdown-it": "^15.0.0",
    "pdfkit": "^0.20.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.0",
    "typescript": "^5.7.0"
  }
}
